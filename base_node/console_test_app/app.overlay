/* Minimal overlay for UART0 to USB CDC ACM bridge on Raspberry Pi Pico */

/ {
	chosen {
		zephyr,console = &cdc_acm_uart0;
	};
};

&zephyr_udc0 {
	cdc_acm_uart0: cdc_acm_uart0 {
		compatible = "zephyr,cdc-acm-uart";
		status = "okay";
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
};
